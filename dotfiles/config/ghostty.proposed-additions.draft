# ─────────────────────────────────────────────────────────────────────────────
# 검토용 DRAFT — ghostty config 추가 후보 (아직 적용 안 됨)
# 검증: Ghostty 1.3.1, `+show-config --default` / `+list-keybinds --default` 대조 (2026-06-14)
#
# ⚠️ 노트(ghostty-features 리서치)의 "[높음] keybind 제안"은 대부분 기각:
#    new_split / goto_split / resize_split / toggle_split_zoom / jump_to_prompt /
#    goto_tab / new_tab / open_config / reload_config / write_scrollback_file 는
#    전부 *이미 Ghostty 기본 keybind*. config에 또 쓰면 중복 → 추가 안 함.
#    (super+d=split, super+1~8=tab, super+arrow=jump_to_prompt, super+,=open_config …)
#
# 아래는 *기본값과 실제로 다른* 옵션만. 적용 전 trade-off 확인 필요한 항목 표시.
# ─────────────────────────────────────────────────────────────────────────────

# ── 클립보드 신뢰성 (이미지/텍스트 paste UX) ────────────────────────────────
# 기본 clipboard-read=ask → 매번 권한 prompt. allow 로 마찰 제거.
clipboard-read = allow
# clipboard-write 는 기본이 이미 allow → 생략.

# ⚠️ 보안 trade-off (사용자 결정 필요): 아래 둘은 paste 사고 방지 가드.
#    false 로 두면 멀티라인/제어문자 paste 가 경고 없이 들어감.
#    어제 세션 config 엔 false 였으나, 이미지 paste 와는 무관해 일단 *주석*으로 보류.
# clipboard-paste-protection = false
# clipboard-paste-bracketed-safe = false

# ── OS 라이트/다크 자동 전환 ────────────────────────────────────────────────
# Profile Auto-Switch(SSH 배경)와 별개. macOS 외관 따라 테마 전환.
# 테마명 검증됨(+list-themes). 취향 바꾸려면 dark/light 값만 교체.
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# ── 세션 연속성 ─────────────────────────────────────────────────────────────
# 재시작 시 창/탭/스플릿 복원. 1인 워크플로 연속성.
window-save-state = always

# ── 미세 UX ─────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
window-padding-balance = true

# ── 보류: 인라인 이미지 표시 (timg/chafa/kitten icat) ───────────────────────
# deep-research(터미널 그래픽 프로토콜) 가 rate-limit 으로 실패 → 근거 없음.
# Ghostty 의 kitty-graphics 지원 범위 확인 후 재검토. 지금은 추가 안 함.
