# 이미지 붙여넣기
#   • Claude Code / AI CLI  →  Ctrl+V   (앱이 클립보드 이미지를 직접 읽음. Cmd+V 금지!)
#   • 그 외(vim/cp 등) 파일 경로가 필요할 때  →  Cmd+Shift+V (img-paste 백업)
#     Cmd+Shift+V 가 C-x C-v 를 보내면 zsh 위젯이 클립보드 이미지를 /tmp 저장 후 경로 삽입
keybind = cmd+shift+v=text:\x18\x16

# 클립보드 신뢰성 — paste 권한 prompt 제거 (이미지/텍스트 paste UX)
clipboard-read = allow
# 보안 trade-off(보류): 아래 둘 false 시 멀티라인/제어문자 paste 가드 해제
# clipboard-paste-protection = false
# clipboard-paste-bracketed-safe = false

# OS 라이트/다크 자동 전환 (Profile Auto-Switch=SSH배경 과는 별개)
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# 재시작 시 창/탭/스플릿 세션 복원
window-save-state = always

# 미세 UX
mouse-hide-while-typing = true
window-padding-balance = true

# Quick Terminal — 어디서든 단축키로 터미널 소환 (registry 등록 기능, keybind 미설정이었음)
keybind = super+backquote=toggle_quick_terminal
