# 이미지 붙여넣기 — Cmd+Shift+V 가 Ctrl+V 바이트(0x16)를 그대로 전송.
#   한글 IME가 Ctrl 키를 먹어서 진짜 Ctrl+V는 0x16을 못 만든다(=이미지 paste 실패).
#   Cmd 조합은 IME가 못 먹으므로, Cmd+Shift+V로 0x16을 쏘면 IME 무관하게
#   Claude Code 이미지 paste가 발동한다. (한글/영문 어느 모드든 동작)
keybind = cmd+shift+v=text:\x16

# 클립보드 신뢰성 — paste 권한 prompt 제거 (이미지/텍스트 paste UX)
clipboard-read = allow
# 보안 trade-off(보류): 아래 둘 false 시 멀티라인/제어문자 paste 가드 해제
# clipboard-paste-protection = false
# clipboard-paste-bracketed-safe = false

# OS 라이트/다크 자동 전환 (Profile Auto-Switch=SSH배경 과는 별개)
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# 재시작 시 창/탭/스플릿 세션 복원
window-save-state = always

# 미세 UX
mouse-hide-while-typing = true
window-padding-balance = true

# Quick Terminal — 어디서든 단축키로 터미널 소환 (registry 등록 기능, keybind 미설정이었음)
keybind = super+backquote=toggle_quick_terminal
